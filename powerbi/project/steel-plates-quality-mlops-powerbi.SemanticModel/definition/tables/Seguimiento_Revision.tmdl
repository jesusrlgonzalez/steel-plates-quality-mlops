table Seguimiento_Revision

	measure 'Piezas' = SUM ( Seguimiento_Revision[piezas] )
		formatString: #,0

	measure 'Piezas a Revision' = SUM ( Seguimiento_Revision[a_revision] )
		formatString: #,0

	measure '% a Revision' = DIVIDE ( [Piezas a Revision], [Piezas] )
		formatString: 0.0%

	measure 'Errores en Aceptadas' = SUM ( Seguimiento_Revision[errores_en_aceptadas] )
		formatString: #,0

	measure 'Escapes por 1000 Aceptadas' = DIVIDE ( [Errores en Aceptadas], SUM ( Seguimiento_Revision[aceptadas] ) ) * 1000
		formatString: #,0.0

	measure 'Costo de Revision MXN' = SUMX ( Seguimiento_Revision, Seguimiento_Revision[a_revision] * Seguimiento_Revision[costo_revision] )
		formatString: #,0

	measure 'Costo de Escapes MXN' = SUMX ( Seguimiento_Revision, Seguimiento_Revision[errores_en_aceptadas] * Seguimiento_Revision[costo_escape] )
		formatString: #,0

	measure 'Costo Total MXN' = [Costo de Revision MXN] + [Costo de Escapes MXN]
		formatString: #,0

	measure 'Costo Revisar Todo MXN' = SUMX ( Seguimiento_Revision, Seguimiento_Revision[piezas] * Seguimiento_Revision[costo_revision] )
		formatString: #,0

	measure 'Ahorro vs Revisar Todo MXN' = [Costo Revisar Todo MXN] - [Costo Total MXN]
		formatString: #,0

	measure 'Semaforo Escapes' =
			VAR actual = [Escapes por 1000 Aceptadas]
			VAR previo =
			    CALCULATE (
			        [Escapes por 1000 Aceptadas],
			        OFFSET ( -1, ALLSELECTED ( Seguimiento_Revision[fecha_corte] ), ORDERBY ( Seguimiento_Revision[fecha_corte] ) )
			    )
			RETURN IF ( NOT ISBLANK ( previo ) && actual > 1.5 * previo, "rojo", "verde" )

	measure 'Piezas Retenidas' = SUM ( Seguimiento_Revision[retenidas] )
		formatString: #,0

	measure 'Estado del Corte' = IF ( CALCULATE ( COUNTROWS ( Seguimiento_Revision ), Seguimiento_Revision[suspendido] = TRUE () ) > 0, "suspendido", "normal" )

	column fecha_corte
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: fecha_corte

	column escenario
		dataType: string
		summarizeBy: none
		sourceColumn: escenario

	column politica
		dataType: string
		summarizeBy: none
		sourceColumn: politica

	column clase
		dataType: string
		summarizeBy: none
		sourceColumn: clase

	column piezas
		dataType: int64
		summarizeBy: none
		sourceColumn: piezas

	column a_revision
		dataType: int64
		summarizeBy: none
		sourceColumn: a_revision

	column aceptadas
		dataType: int64
		summarizeBy: none
		sourceColumn: aceptadas

	column retenidas
		dataType: int64
		summarizeBy: none
		sourceColumn: retenidas

	column errores_en_aceptadas
		dataType: int64
		summarizeBy: none
		sourceColumn: errores_en_aceptadas

	column costo_revision
		dataType: double
		summarizeBy: none
		sourceColumn: costo_revision

	column costo_escape
		dataType: double
		summarizeBy: none
		sourceColumn: costo_escape

	column costo_errores
		dataType: double
		summarizeBy: none
		sourceColumn: costo_errores

	column suspendido
		dataType: boolean
		summarizeBy: none
		sourceColumn: suspendido

	column clausula_iso9001
		dataType: string
		summarizeBy: none
		sourceColumn: clausula_iso9001

	partition Seguimiento_Revision = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaRevisionCSV), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cabecera = Table.PromoteHeaders(Origen, [PromoteAllScalars=true]),
				    Esperadas = {"fecha_corte", "escenario", "politica", "clase", "piezas", "a_revision", "aceptadas", "retenidas", "errores_en_aceptadas", "costo_revision", "costo_escape", "costo_errores", "suspendido", "clausula_iso9001"},
				    Schema = if Table.ColumnNames(Cabecera) = Esperadas then Cabecera else error "Seguimiento schema mismatch",
				    Tipos = Table.TransformColumnTypes(Schema, {{"fecha_corte", type date}, {"escenario", type text}, {"politica", type text}, {"clase", type text}, {"piezas", Int64.Type}, {"a_revision", Int64.Type}, {"aceptadas", Int64.Type}, {"retenidas", Int64.Type}, {"errores_en_aceptadas", Int64.Type}, {"costo_revision", type number}, {"costo_escape", type number}, {"costo_errores", type number}, {"suspendido", type logical}, {"clausula_iso9001", type text}}, "en-US"),
				    Validado = if List.ContainsAll({"S1", "S2", "S3"}, List.Distinct(Tipos[escenario])) and Table.RowCount(Tipos) > 0
				        then Tipos else error "Expected P02 scenarios S1-S3"
				in
				    Validado
