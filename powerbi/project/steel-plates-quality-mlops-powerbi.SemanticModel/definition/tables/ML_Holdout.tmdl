table ML_Holdout
	lineageTag: ab5dd6ad-1b5d-4d93-ab61-a3ad80eada60

	measure 'Final Macro-F1 (389)' = 0.8146728101764369
		formatString: 0.0000
		lineageTag: 75a6c054-e709-413b-963b-cf6d735d7321

	measure 'Final Balanced Accuracy (389)' = 0.8048726799979933
		formatString: 0.0000
		lineageTag: bbb18c0f-bed7-4a1f-836f-34d8ef83a5a9

	measure 'ML Rows' = COUNTROWS ( ML_Holdout )
		formatString: 0
		lineageTag: e43572ab-e1df-4976-8c74-d28e4807fc66

	measure 'ML Correct' = SUM ( ML_Holdout[correct_prediction] )
		formatString: 0
		lineageTag: e51c5d98-b447-46d6-99e1-bbab04a4c807

	measure 'ML Errors' = [ML Rows] - [ML Correct]
		formatString: 0
		lineageTag: 414312bf-c0a1-4358-8292-5f5e517f1f13

	measure 'ML Confusion Errors' = IF ( [ML Errors] > 0, [ML Errors], BLANK () )
		formatString: 0
		lineageTag: 11613978-d3df-4c32-a353-6098979324d1

	measure 'ML Review Rows' = SUM ( ML_Holdout[review_required] )
		formatString: 0
		lineageTag: 5596e889-c236-493c-badc-aefa5afeb103

	measure 'Candidate Review Rate' = DIVIDE ( [ML Review Rows], [ML Rows] )
		formatString: 0.00%
		lineageTag: 94379ef6-d10a-407c-95fb-077df3ff0c78

	measure 'Observed Accuracy' = DIVIDE ( [ML Correct], [ML Rows] )
		formatString: 0.00%
		lineageTag: 6d8351a5-20d8-4af3-8d9f-8b07f2911d5c

	measure 'Observed Error Rate' = DIVIDE ( [ML Errors], [ML Rows] )
		formatString: 0.00%
		lineageTag: c94af36e-058e-4109-9114-ba93b37560c6

	measure 'Mean Confidence' = AVERAGE ( ML_Holdout[confidence] )
		formatString: 0.00%
		lineageTag: 24774da0-2d9e-4c85-876b-1492cdd9914b

	measure 'Segment Support' = IF ( [ML Rows] < 30, "INSUFFICIENT_DATA", "DESCRIPTIVE" )
		lineageTag: 95c50cec-bb1c-4fbf-8608-7313c7595421

